package seleminiprjt;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
public class Assinminiprj {
	static WebDriver driver;
	static String url ="https://petstore.octoperf.com/actions/Catalog.action";
	static String cat_xpath="//div [@id ='SidebarContent']/a[3]";
	static String product_xpath="//tbody/tr[3]/td[1]";
	static String addToCart_cssSelector=".Button";
	static String Qty_txt_css ="input[name='EST-16']";
	static String update_xpath="//input[contains(@value,'Update')]";
	static String proceed_checkout_xpath="//a[contains(text(),'Proceed')]";
	public static void validURL(String partOfURL,String page) {
		String actURL = driver.getCurrentUrl();
		if(actURL.contains(partOfURL)) {
			System.out.println(page + ": Pass");
		}else {
			System.out.println(page + ": Fail");
		}
	}
	public static void setUp() {
		driver=new ChromeDriver();
		driver.get(url);
	}
	public static void selectCat() {
		driver.findElement(By.xpath(cat_xpath)).click();
		validURL("categoryId=CATS","HomePage");
	}
	public static void selectProduct() {
		driver.findElement(By.xpath(product_xpath)).click();
		validURL("FL-DLH-02","Product page");
	}
	public static void addToCart() {
		driver.findElement(By.cssSelector(addToCart_cssSelector)).click();
		validURL("EST-16","Add to cart");
	}
	public static void updateCart() {
		driver.findElement(By.cssSelector(Qty_txt_css)).clear();
		driver.findElement(By.cssSelector(Qty_txt_css)).sendKeys("5");
		driver.findElement(By.xpath(update_xpath)).click();
		validURL("EST-16","Update cart");
	}
	public static void checkOut() {
		driver.findElement(By.xpath(proceed_checkout_xpath)).click();
		validURL("newOrderForm","Chechout");
	}
	public static void ruleout() {
		driver.close();
	}
	public static void main(String[] args) {
		setUp();
		selectCat();
		selectProduct();
		addToCart();
		updateCart();
		checkOut();
		ruleout();
	}
}
